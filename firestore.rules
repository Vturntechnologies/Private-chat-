rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (request.auth.token.email == "karthickpraveen072@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUser() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt']) &&
             data.uid is string &&
             data.email is string &&
             data.displayName is string &&
             data.role in ['admin', 'user'] &&
             data.createdAt is timestamp &&
             (!('photoURL' in data) || data.photoURL is string);
    }

    function isValidChat() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['participants', 'updatedAt', 'lastMessage']) &&
             data.participants is list &&
             data.participants.size() == 2 &&
             data.updatedAt is timestamp &&
             (!('lastMessage' in data) || data.lastMessage is string);
    }

    function isValidMessage() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['chatId', 'senderId', 'text', 'createdAt']) &&
             data.chatId is string &&
             data.senderId is string &&
             data.text is string && data.text.size() > 0 && data.text.size() < 5000 &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidUser() && (isAdmin() || (isOwner(userId) && request.resource.data.role == 'user'));
      allow update: if isAuthenticated() && isValidUser() && (isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && isValidChat() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && isValidChat() && request.auth.uid in resource.data.participants && request.auth.uid in request.resource.data.participants;
      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants;
      allow create: if isAuthenticated() && isValidMessage() && request.auth.uid == request.resource.data.senderId && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants;
      allow update: if false; // Messages cannot be edited
      allow delete: if isAdmin();
    }
  }
}
